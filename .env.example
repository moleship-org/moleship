# -------------------------------------------
# Application
# -------------------------------------------
MOLESHIP_PORT=5000
MOLESHIP_LOG_LEVEL=info
MOLESHIP_MODE=debug
MOLESHIP_ROOTFUL=false

# -------------------------------------------
# Host
# -------------------------------------------
MOLESHIP_HOST_USER=
MOLESHIP_HOST_UID=

# -------------------------------------------
# Data paths
# -------------------------------------------
# Rootless default: /home/$USER/.config/moleship
MOLESHIP_CONFIG_HOME=
# Rootless default: /home/$USER/.local/share/moleship
MOLESHIP_DATA_HOME=
# Rootless default: /home/$USER/.cache/moleship
MOLESHIP_CACHE_HOME=
# Rootless default: /home/$USER/.config/containers/systemd
MOLESHIP_QUADLET_HOME=

# -------------------------------------------
# Binaries and sockets
# -------------------------------------------
# Rootless default: /run/user/<UID>/podman/podman.sock
MOLESHIP_PODMAN_SOCKET=
# Default: /usr/bin/podman
MOLESHIP_PODMAN_PATH=
# Default: /usr/bin/systemctl
MOLESHIP_SYSTEMCTL_PATH=

# -------------------------------------------
# Others
# -------------------------------------------
MOLESHIP_JWT_SECRET=
MOLESHIP_IP_HEADER_LOOKUP=
MOLESHIP_ALLOWED_ORIGINS=
MOLESHIP_ENABLE_LIBPOD_PROXY=false

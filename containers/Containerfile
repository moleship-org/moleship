# Containerfile for moleship (github.com/moleship-org/moleship)

## Build stage
ARG GO_VERSION=1.27
FROM docker.io/library/golang:${GO_VERSION}-trixie AS build

ARG BIN=moleship
ARG VERSION=main
ARG TARGETOS
ARG TARGETARCH

# Build-time C dependencies required by CGO
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        make \
        pkg-config \
        libgpgme-dev \
        libbtrfs-dev \
        libdevmapper-dev \
        libseccomp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Cache module downloads separately from source changes.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Building
RUN make build \
        BIN="${BIN}" \
        VERSION="${VERSION}" \
        ARCH="${TARGETOS}-${TARGETARCH}"

## Runtime stage
FROM docker.io/library/debian:trixie-slim AS runtime

ARG BIN=moleship
ARG TARGETOS=linux
ARG TARGETARCH=amd64

LABEL org.opencontainers.image.title="moleship" \
      org.opencontainers.image.description="RESTful API backend for managing Quadlet-generated systemd unit files for Podman containers" \
      org.opencontainers.image.source="https://github.com/moleship-org/moleship" \
      org.opencontainers.image.vendor="moleship-org"

# Runtime dependencies and preconfiguration of directories
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd \
        libgpgme11t64 \
        libassuan9 \
        gnupg \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --home-dir /home/moleship --shell /usr/sbin/nologin moleship \
    && mkdir -p /home/moleship/.config/moleship \
                /home/moleship/.cache/moleship \
                /home/moleship/.local/share/moleship \
                /home/moleship/.config/containers/systemd \
    && chmod -R 0755 /home/moleship

COPY --from=build /src/_oputput/bin/${TARGETOS}/${TARGETARCH}/${BIN} /usr/local/bin/moleship

ENV HOME=/home/moleship \
    MOLESHIP_PORT=5000 \
    MOLESHIP_SYSTEMCTL_PATH=/usr/bin/systemctl \
    MOLESHIP_PODMAN_SOCKET=/run/podman/podman.sock

USER moleship
WORKDIR /home/moleship

EXPOSE 5000

ENTRYPOINT ["/usr/local/bin/moleship"]
CMD ["serve"]

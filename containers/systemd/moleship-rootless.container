# Quadlet unit for moleship -- rootless variant (default)

[Unit]
Description=Moleship - Quadlet management API for Podman and Systemd (rootless)
Wants=podman.socket
After=podman.socket

[Container]
Image=ghcr.io/moleship-org/moleship:latest
ContainerName=moleship

User=%U:%U
UserNS=keep-id

# Required for `systemctl` to actually work against the host's systemd instance.
PodmanArgs=--pid=host

# %t expands to $XDG_RUNTIME_DIR for a user manager (e.g. /run/user/1000),
# which contains both the D-Bus session socket (bus) and the Podman socket
# (podman/podman.sock).
Volume=%t:%t
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=MOLESHIP_HOST_UID=%U
Environment=MOLESHIP_HOST_USER=%u
Environment=MOLESHIP_PODMAN_SOCKET=%t/podman/podman.sock

# Default CORS allow-list.
# Add here any origins that should be allowed to access the API.
# It has the default target port of 3000 for the colossus frontend.
Environment=MOLESHIP_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000

# Persist moleship's own state.
Volume=%h/.config/moleship:/home/moleship/.config/moleship
Volume=%h/.cache/moleship:/home/moleship/.cache/moleship
Volume=%h/.local/share/moleship:/home/moleship/.local/share/moleship
Volume=%h/.config/containers/systemd:/home/moleship/.config/containers/systemd

PublishPort=5000:5000

[Service]
Restart=on-failure
TimeoutStartSec=30

[Install]
WantedBy=default.target

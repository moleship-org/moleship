# Quadlet unit for moleship -- rootful variant.

[Unit]
Description=Moleship - Quadlet management API for Podman and Systemd (rootful)
Wants=podman.socket
After=podman.socket

[Container]
Image=ghcr.io/moleship-org/moleship:latest
ContainerName=moleship

User=root:root

# Required for `systemctl` to actually work against the host's systemd instance.
PodmanArgs=--pid=host

# System D-Bus
Volume=/run/dbus:/run/dbus
Volume=/run/podman:/run/podman
Environment=MOLESHIP_ROOTFUL=true
Environment=MOLESHIP_PODMAN_SOCKET=/run/podman/podman.sock

# There's no single "current user" for a rootful, system-level deployment,
# so MOLESHIP_HOST_USER can't be auto-derived the way the rootless unit
# derives it from %u
Environment=MOLESHIP_HOST_USER=root

# Default CORS allow-list.
# Add here any origins that should be allowed to access the API.
# It has the default target port of 3000 for the colossus frontend.
Environment=MOLESHIP_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000

# Persist moleship's own state.
Volume=/etc/moleship:/etc/moleship
Volume=/var/cache/moleship:/var/cache/moleship
Volume=/var/lib/moleship:/var/lib/moleship
Volume=/etc/containers/systemd:/etc/containers/systemd

PublishPort=5000:5000

[Service]
Restart=on-failure
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
